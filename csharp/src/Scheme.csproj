<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>scheme</AssemblyName>
    <RootNamespace>Scheme</RootNamespace>
    <StartupObject>Scheme.InterpreterShell</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>CS0660;CS0661;CS0169;CS0414;CA2200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\lib\psyntax.pp" Link="psyntax.pp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\lib\init.scm" Link="init.scm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
